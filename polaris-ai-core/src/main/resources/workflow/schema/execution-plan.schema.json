{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schema/execution-plan.schema.json",
  "title": "Polaris Workflow ExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["planSchemaVersion", "definitionSchemaVersion", "workflowVersionId", "contentHash", "inputs", "entryNodeIds", "nodes", "edges", "outputs", "policies"],
  "properties": {
    "planSchemaVersion": { "const": "2.0" },
    "definitionSchemaVersion": { "const": "2.0" },
    "workflowVersionId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputs": { "type": "object", "additionalProperties": true },
    "entryNodeIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "handlerVersion", "inputMapping", "config", "sideEffect"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "type": { "type": "string", "minLength": 1, "maxLength": 64 },
          "handlerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "inputMapping": { "type": "object", "additionalProperties": true },
          "config": { "type": "object", "additionalProperties": true },
          "sideEffect": { "enum": ["NONE", "READ", "WRITE"] },
          "timeoutSeconds": { "type": "integer", "minimum": 1 },
          "retryPolicy": { "type": "object", "additionalProperties": true },
          "resourceRefs": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "kind", "priority", "default"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "sourcePort": { "type": ["string", "null"], "maxLength": 64 },
          "kind": { "enum": ["NORMAL", "CONDITION", "PARALLEL", "LOOP", "SEMANTIC"] },
          "expressionAst": { "type": ["object", "null"], "additionalProperties": true },
          "priority": { "type": "integer", "minimum": 0 },
          "default": { "type": "boolean" }
        }
      }
    },
    "outputs": { "type": "object", "additionalProperties": true },
    "policies": { "type": "object", "additionalProperties": true }
  }
}
