<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.polaris.platform.mapper.CustomerServiceAvatarAssetMapper">
    <resultMap id="Asset" type="com.polaris.platform.domain.CustomerServiceAvatarAsset">
        <id property="id" column="id" />
        <result property="tenantId" column="tenant_id" /><result property="name" column="name" />
        <result property="kind" column="kind" /><result property="contentType" column="content_type" />
        <result property="byteSize" column="byte_size" /><result property="contentHash" column="content_hash" />
        <result property="createBy" column="create_by" /><result property="createTime" column="create_time" />
    </resultMap>
    <select id="lockTenant" resultType="long">select tenant_id from platform_tenant where tenant_id=#{tenantId} for update</select>
    <select id="lockAssets" resultMap="Asset">select * from platform_customer_avatar_asset where tenant_id=#{tenantId} order by id for update</select>
    <select id="list" resultMap="Asset">select * from platform_customer_avatar_asset where tenant_id=#{tenantId} order by create_time desc,id desc</select>
    <select id="select" resultMap="Asset">select * from platform_customer_avatar_asset where tenant_id=#{tenantId} and id=#{id}</select>
    <insert id="insert">
        insert into platform_customer_avatar_asset (id,tenant_id,name,kind,content_type,byte_size,content_hash,create_by,create_time)
        values (#{id},#{tenantId},#{name},#{kind},#{contentType},#{byteSize},#{contentHash},#{createBy},#{createTime})
    </insert>
</mapper>
