<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.polaris.platform.mapper.PlatformApiConnectorMapper">
    
    <resultMap type="com.polaris.platform.domain.PlatformApiConnector" id="PlatformApiConnectorResult">
        <id     property="id"             column="id"              />
        <result property="tenantId"       column="tenant_id"       />
        <result property="connectorName"  column="connector_name"  />
        <result property="baseUrl"        column="base_url"        />
        <result property="authType"       column="auth_type"       />
        <result property="authConfig"     column="auth_config"     />
        <result property="defaultHeaders" column="default_headers" />
        <result property="timeoutMs"      column="timeout_ms"      />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
    </resultMap>

    <sql id="selectPlatformApiConnectorVo">
        select id, tenant_id, connector_name, base_url, auth_type, auth_config, default_headers, timeout_ms, status, create_by, create_time, update_by, update_time
        from platform_api_connector
    </sql>

    <select id="selectById" parameterType="Long" resultMap="PlatformApiConnectorResult">
        <include refid="selectPlatformApiConnectorVo"/>
        where id = #{id}
    </select>

    <select id="selectByTenantId" parameterType="Long" resultMap="PlatformApiConnectorResult">
        <include refid="selectPlatformApiConnectorVo"/>
        where tenant_id = #{tenantId}
        order by create_time desc
    </select>

    <select id="selectWorkflowResource" resultMap="PlatformApiConnectorResult">
        <include refid="selectPlatformApiConnectorVo"/>
        where id = #{id}
        <choose>
            <when test="tenantId != null">
                and (tenant_id = #{tenantId} or tenant_id is null)
            </when>
            <otherwise>
                and tenant_id is null
            </otherwise>
        </choose>
        limit 1
    </select>

    <select id="selectWorkflowResources" resultMap="PlatformApiConnectorResult">
        <include refid="selectPlatformApiConnectorVo"/>
        <choose>
            <when test="tenantId != null">
                where tenant_id = #{tenantId} or tenant_id is null
            </when>
            <otherwise>
                where tenant_id is null
            </otherwise>
        </choose>
        order by case when tenant_id is null then 1 else 0 end, connector_name, id
    </select>

    <select id="selectList" parameterType="com.polaris.platform.domain.PlatformApiConnector" resultMap="PlatformApiConnectorResult">
        <include refid="selectPlatformApiConnectorVo"/>
        <where>
            <if test="tenantId != null">
                AND tenant_id = #{tenantId}
            </if>
            <if test="connectorName != null and connectorName != ''">
                AND connector_name like concat('%', #{connectorName}, '%')
            </if>
            <if test="authType != null and authType != ''">
                AND auth_type = #{authType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <insert id="insert" parameterType="com.polaris.platform.domain.PlatformApiConnector" useGeneratedKeys="true" keyProperty="id">
        insert into platform_api_connector(
            <if test="tenantId != null">tenant_id,</if>
            <if test="connectorName != null and connectorName != ''">connector_name,</if>
            <if test="baseUrl != null and baseUrl != ''">base_url,</if>
            <if test="authType != null and authType != ''">auth_type,</if>
            <if test="authConfig != null">auth_config,</if>
            <if test="defaultHeaders != null">default_headers,</if>
            <if test="timeoutMs != null">timeout_ms,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="tenantId != null">#{tenantId},</if>
            <if test="connectorName != null and connectorName != ''">#{connectorName},</if>
            <if test="baseUrl != null and baseUrl != ''">#{baseUrl},</if>
            <if test="authType != null and authType != ''">#{authType},</if>
            <if test="authConfig != null">#{authConfig},</if>
            <if test="defaultHeaders != null">#{defaultHeaders},</if>
            <if test="timeoutMs != null">#{timeoutMs},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="update" parameterType="com.polaris.platform.domain.PlatformApiConnector">
        update platform_api_connector
        <set>
            <if test="connectorName != null and connectorName != ''">connector_name = #{connectorName},</if>
            <if test="baseUrl != null and baseUrl != ''">base_url = #{baseUrl},</if>
            <if test="authType != null and authType != ''">auth_type = #{authType},</if>
            <if test="authConfig != null">auth_config = #{authConfig},</if>
            <if test="defaultHeaders != null">default_headers = #{defaultHeaders},</if>
            <if test="timeoutMs != null">timeout_ms = #{timeoutMs},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        delete from platform_api_connector where id = #{id}
    </delete>

</mapper>
