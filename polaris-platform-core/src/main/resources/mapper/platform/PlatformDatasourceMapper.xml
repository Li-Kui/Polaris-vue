<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.polaris.platform.mapper.PlatformDatasourceMapper">
    
    <resultMap type="com.polaris.platform.domain.PlatformDatasource" id="PlatformDatasourceResult">
        <id     property="id"           column="id"            />
        <result property="tenantId"     column="tenant_id"     />
        <result property="dsName"       column="ds_name"       />
        <result property="dsType"       column="ds_type"       />
        <result property="jdbcUrl"      column="jdbc_url"      />
        <result property="username"     column="username"      />
        <result property="password"     column="password"      />
        <result property="queryTimeout" column="query_timeout" />
        <result property="readOnly"     column="read_only"     />
        <result property="extraConfig"  column="extra_config"  />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <sql id="selectPlatformDatasourceVo">
        select id, tenant_id, ds_name, ds_type, jdbc_url, username, password, query_timeout, read_only, extra_config, status, create_by, create_time, update_by, update_time
        from platform_datasource
    </sql>

    <select id="selectById" parameterType="Long" resultMap="PlatformDatasourceResult">
        <include refid="selectPlatformDatasourceVo"/>
        where id = #{id}
    </select>

    <select id="selectByTenantId" parameterType="Long" resultMap="PlatformDatasourceResult">
        <include refid="selectPlatformDatasourceVo"/>
        where tenant_id = #{tenantId}
        order by create_time desc
    </select>

    <select id="selectWorkflowResource" resultMap="PlatformDatasourceResult">
        <include refid="selectPlatformDatasourceVo"/>
        where id = #{id}
        <choose>
            <when test="tenantId != null">
                and (tenant_id = #{tenantId} or tenant_id is null)
            </when>
            <otherwise>
                and tenant_id is null
            </otherwise>
        </choose>
        limit 1
    </select>

    <select id="selectWorkflowResources" resultMap="PlatformDatasourceResult">
        <include refid="selectPlatformDatasourceVo"/>
        <choose>
            <when test="tenantId != null">
                where tenant_id = #{tenantId} or tenant_id is null
            </when>
            <otherwise>
                where tenant_id is null
            </otherwise>
        </choose>
        order by case when tenant_id is null then 1 else 0 end, ds_name, id
    </select>

    <select id="selectList" parameterType="com.polaris.platform.domain.PlatformDatasource" resultMap="PlatformDatasourceResult">
        <include refid="selectPlatformDatasourceVo"/>
        <where>
            <if test="tenantId != null">
                AND tenant_id = #{tenantId}
            </if>
            <if test="dsName != null and dsName != ''">
                AND ds_name like concat('%', #{dsName}, '%')
            </if>
            <if test="dsType != null and dsType != ''">
                AND ds_type = #{dsType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <insert id="insert" parameterType="com.polaris.platform.domain.PlatformDatasource" useGeneratedKeys="true" keyProperty="id">
        insert into platform_datasource(
            <if test="tenantId != null">tenant_id,</if>
            <if test="dsName != null and dsName != ''">ds_name,</if>
            <if test="dsType != null and dsType != ''">ds_type,</if>
            <if test="jdbcUrl != null and jdbcUrl != ''">jdbc_url,</if>
            <if test="username != null and username != ''">username,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="queryTimeout != null">query_timeout,</if>
            <if test="readOnly != null">read_only,</if>
            <if test="extraConfig != null">extra_config,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="tenantId != null">#{tenantId},</if>
            <if test="dsName != null and dsName != ''">#{dsName},</if>
            <if test="dsType != null and dsType != ''">#{dsType},</if>
            <if test="jdbcUrl != null and jdbcUrl != ''">#{jdbcUrl},</if>
            <if test="username != null and username != ''">#{username},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="queryTimeout != null">#{queryTimeout},</if>
            <if test="readOnly != null">#{readOnly},</if>
            <if test="extraConfig != null">#{extraConfig},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="update" parameterType="com.polaris.platform.domain.PlatformDatasource">
        update platform_datasource
        <set>
            <if test="dsName != null and dsName != ''">ds_name = #{dsName},</if>
            <if test="dsType != null and dsType != ''">ds_type = #{dsType},</if>
            <if test="jdbcUrl != null and jdbcUrl != ''">jdbc_url = #{jdbcUrl},</if>
            <if test="username != null">username = #{username},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="queryTimeout != null">query_timeout = #{queryTimeout},</if>
            <if test="readOnly != null">read_only = #{readOnly},</if>
            <if test="extraConfig != null">extra_config = #{extraConfig},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        delete from platform_datasource where id = #{id}
    </delete>

</mapper>
