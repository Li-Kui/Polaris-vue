<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>polaris</artifactId>
        <groupId>com.polaris</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>polaris-ai</artifactId>

    <description>
       ai大模型模块
    </description>

    <dependencies>

        <!-- 本地敏感内容候选匹配；项目使用自带的受控种子，不引入公共运行时词库。 -->
        <dependency>
            <groupId>com.github.houbb</groupId>
            <artifactId>sensitive-word</artifactId>
            <version>${sensitive-word.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.github.houbb</groupId>
                    <artifactId>sensitive-word-data</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.github.houbb</groupId>
            <artifactId>pinyin</artifactId>
            <version>${houbb-pinyin.version}</version>
        </dependency>

        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>green20220302</artifactId>
            <version>${aliyun-green.version}</version>
        </dependency>

		<!-- LangChain4j 核心 -->
		<dependency>
		    <groupId>dev.langchain4j</groupId>
		    <artifactId>langchain4j</artifactId>
		</dependency>
		
		<!-- OpenAI 适配（DashScope / DeepSeek / OpenAI 均走此模块） -->
		<dependency>
		    <groupId>dev.langchain4j</groupId>
		    <artifactId>langchain4j-open-ai</artifactId>
		</dependency>

		<!-- Qdrant 向量存储适配（版本由根 BOM 对齐） -->
		<dependency>
		    <groupId>dev.langchain4j</groupId>
		    <artifactId>langchain4j-qdrant</artifactId>
		</dependency>

		<dependency>
		    <groupId>io.qdrant</groupId>
		    <artifactId>client</artifactId>
		</dependency>
		
		<!-- SpringWeb模块 -->
		<dependency>
		    <groupId>org.springframework</groupId>
		    <artifactId>spring-webmvc</artifactId>
		</dependency>
		
		<!-- AI核心引擎层 -->
		<dependency>
		    <groupId>com.polaris</groupId>
		    <artifactId>polaris-ai-core</artifactId>
		</dependency>

		<!-- 通用工具-->
		<dependency>
		    <groupId>com.polaris</groupId>
		    <artifactId>polaris-common</artifactId>
		</dependency>

		<!-- 引入系统管理模块，以使用用户、角色、部门等服务接口 -->
		<dependency>
		    <groupId>com.polaris</groupId>
		    <artifactId>polaris-system</artifactId>
		</dependency>

		<!-- PDF 解析器 PDFBox -->
		<dependency>
		    <groupId>org.apache.pdfbox</groupId>
		    <artifactId>pdfbox</artifactId>
		    <version>2.0.31</version>
		</dependency>

		<!-- Lombok 依赖 -->
		<dependency>
		    <groupId>org.projectlombok</groupId>
		    <artifactId>lombok</artifactId>
		    <scope>provided</scope>
		</dependency>

		<dependency>
		    <groupId>org.springframework.boot</groupId>
		    <artifactId>spring-boot-starter-test</artifactId>
		    <scope>test</scope>
		</dependency>

    </dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.4</version>
				<configuration>
					<!-- JDK 17 及以上版本可能阻止 Mockito 在运行时自行附加代理。 -->
					<argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
