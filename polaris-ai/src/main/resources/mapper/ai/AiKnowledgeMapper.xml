<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.polaris.ai.mapper.AiKnowledgeMapper">

    <!-- ==================== 知识库 ==================== -->
    <resultMap id="KnowledgeBaseResult" type="com.polaris.ai.domain.AiKnowledgeBase">
        <id     property="id"          column="id"/>
        <result property="name"        column="name"/>
        <result property="description" column="description"/>
        <result property="deptId"      column="dept_id"/>
        <result property="createBy"    column="create_by"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateBy"    column="update_by"/>
        <result property="updateTime"  column="update_time"/>
        <result property="delFlag"     column="del_flag"/>
    </resultMap>



    <!-- 知识库 CRUD -->
    <insert id="insertKnowledgeBase" parameterType="com.polaris.ai.domain.AiKnowledgeBase"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_knowledge_base(name, description, dept_id, del_flag, create_by, create_time, update_by, update_time)
        VALUES (#{name}, #{description}, #{deptId}, '0', #{createBy}, NOW(), #{createBy}, NOW())
    </insert>

    <update id="updateKnowledgeBase" parameterType="com.polaris.ai.domain.AiKnowledgeBase">
        UPDATE ai_knowledge_base
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>


    <select id="selectKnowledgeBaseList" resultMap="KnowledgeBaseResult">
        SELECT kb.* FROM ai_knowledge_base kb
        <where>
            kb.del_flag = '0'
            <if test="name != null and name != ''">
                AND kb.name LIKE concat('%', #{name}, '%')
            </if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
        ORDER BY kb.create_time DESC
    </select>

    <select id="selectKnowledgeBaseById" resultMap="KnowledgeBaseResult">
        SELECT * FROM ai_knowledge_base WHERE id = #{id} AND del_flag = '0'
    </select>



</mapper>
