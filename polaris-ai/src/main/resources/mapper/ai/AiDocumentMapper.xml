<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.polaris.ai.mapper.AiDocumentMapper">
    
    <resultMap id="DocumentResult" type="com.polaris.ai.domain.AiDocument">
        <id     property="id"              column="id"/>
        <result property="knowledgeBaseId" column="knowledge_base_id"/>
        <result property="name"            column="name"/>
        <result property="fileUrl"         column="file_url"/>
        <result property="status"               column="status"/>
        <result property="wordCount"            column="word_count"/>
        <result property="moderationStatus"     column="moderation_status"/>
        <result property="moderationEventId"    column="moderation_event_id"/>
        <result property="moderationVersion"    column="moderation_version"/>
        <result property="quarantinePath"       column="quarantine_path"/>
        <result property="quarantineExpireTime" column="quarantine_expire_time"/>
        <result property="createBy"             column="create_by"/>
        <result property="createTime"           column="create_time"/>
        <result property="delFlag"              column="del_flag"/>
    </resultMap>

    <select id="selectDocumentList" resultMap="DocumentResult">
        SELECT * FROM ai_document
        <where>
            del_flag = '0'
            <if test="knowledgeBaseId != null">
                AND knowledge_base_id = #{knowledgeBaseId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE concat('%', #{name}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
