<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.polaris.ai.mapper.AiModelConfigMapper">

    <resultMap id="AiModelConfigResult" type="com.polaris.ai.domain.AiModelConfig">
        <id     property="id"                 column="id"/>
        <result property="name"               column="name"/>
        <result property="provider"           column="provider"/>
        <result property="modelName"          column="model_name"/>
        <result property="apiKey"             column="api_key"/>
        <result property="baseUrl"            column="base_url"/>
        <result property="maxTokens"          column="max_tokens"/>
        <result property="temperature"        column="temperature"/>
        <result property="maxHistoryMessages" column="max_history_messages"/>
        <result property="systemPrompt"        column="system_prompt"/>
        <result property="isDefault"          column="is_default"/>
        <result property="modelType"          column="model_type"/>
        <result property="enabledTools"       column="enabled_tools"/>
        <result property="enableThinking"     column="enable_thinking"/>
        <result property="reasoningEffort"    column="reasoning_effort"/>
        <result property="deptId"              column="dept_id"/>
        <result property="enableSearch"       column="enable_search"/>
        <result property="searchKey"          column="search_key"/>
        <result property="imageCapabilities"  column="image_capabilities"/>
        <result property="modelFeatures"      column="model_features"/>
        <result property="defaultImageSize"   column="default_image_size"/>
        <result property="modelDescription"   column="model_description"/>
        <result property="accessMode"        column="access_mode"/>
        <result property="maxConcurrency"    column="max_concurrency"/>
        <result property="status"             column="status"/>
        <result property="delFlag"            column="del_flag"/>
        <result property="createBy"           column="create_by"/>
        <result property="createTime"         column="create_time"/>
        <result property="updateBy"           column="update_by"/>
        <result property="updateTime"         column="update_time"/>
    </resultMap>

    <sql id="selectAiModelConfigVo">
        SELECT * FROM ai_model_config
    </sql>

    <select id="selectModelConfigList" parameterType="com.polaris.ai.domain.AiModelConfig" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        <where>
            AND del_flag = '0'
            <if test="name != null and name != ''">
                AND name LIKE concat('%', #{name}, '%')
            </if>
            <if test="provider != null and provider != ''">
                AND provider = #{provider}
            </if>
            <if test="modelName != null and modelName != ''">
                AND model_name = #{modelName}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectModelConfigById" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        WHERE id = #{id} AND del_flag = '0'
    </select>

    <select id="selectModelConfigByModelName" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        WHERE model_name = #{modelName} AND status = '1' AND del_flag = '0'
        LIMIT 1
    </select>

    <select id="selectDefaultModel" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        <where>
            AND model_type = #{modelType} AND is_default = '1' AND status = '1' AND del_flag = '0'
            <if test="dataScopeSql != null and dataScopeSql != ''">
                ${dataScopeSql}
            </if>
        </where>
        ORDER BY 
            (CASE 
                <if test="userDeptId != null">
                    WHEN dept_id = #{userDeptId} THEN 2
                </if>
                WHEN dept_id IS NULL THEN 0
                ELSE 1 
            END) DESC,
            id DESC
        LIMIT 1
    </select>

    <insert id="insertModelConfig" parameterType="com.polaris.ai.domain.AiModelConfig" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_model_config (
            <if test="name != null and name != ''">name,</if>
            <if test="provider != null and provider != ''">provider,</if>
            <if test="modelName != null and modelName != ''">model_name,</if>
            <if test="apiKey != null">api_key,</if>
            <if test="baseUrl != null">base_url,</if>
            <if test="maxTokens != null">max_tokens,</if>
            <if test="temperature != null">temperature,</if>
            <if test="maxHistoryMessages != null">max_history_messages,</if>
            <if test="systemPrompt != null">system_prompt,</if>
            <if test="isDefault != null and isDefault != ''">is_default,</if>
            <if test="modelType != null and modelType != ''">model_type,</if>
            <if test="enabledTools != null">enabled_tools,</if>
            <if test="enableThinking != null and enableThinking != ''">enable_thinking,</if>
            <if test="reasoningEffort != null and reasoningEffort != ''">reasoning_effort,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="enableSearch != null and enableSearch != ''">enable_search,</if>
            <if test="searchKey != null">search_key,</if>
            <if test="imageCapabilities != null">image_capabilities,</if>
            <if test="modelFeatures != null">model_features,</if>
            <if test="defaultImageSize != null">default_image_size,</if>
            <if test="modelDescription != null">model_description,</if>
            <if test="accessMode != null and accessMode != ''">access_mode,</if>
            <if test="maxConcurrency != null">max_concurrency,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            del_flag,
            create_time
        ) VALUES (
            <if test="name != null and name != ''">#{name},</if>
            <if test="provider != null and provider != ''">#{provider},</if>
            <if test="modelName != null and modelName != ''">#{modelName},</if>
            <if test="apiKey != null">#{apiKey},</if>
            <if test="baseUrl != null">#{baseUrl},</if>
            <if test="maxTokens != null">#{maxTokens},</if>
            <if test="temperature != null">#{temperature},</if>
            <if test="maxHistoryMessages != null">#{maxHistoryMessages},</if>
            <if test="systemPrompt != null">#{systemPrompt},</if>
            <if test="isDefault != null and isDefault != ''">#{isDefault},</if>
            <if test="modelType != null and modelType != ''">#{modelType},</if>
            <if test="enabledTools != null">#{enabledTools},</if>
            <if test="enableThinking != null and enableThinking != ''">#{enableThinking},</if>
            <if test="reasoningEffort != null and reasoningEffort != ''">#{reasoningEffort},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="enableSearch != null and enableSearch != ''">#{enableSearch},</if>
            <if test="searchKey != null">#{searchKey},</if>
            <if test="imageCapabilities != null">#{imageCapabilities},</if>
            <if test="modelFeatures != null">#{modelFeatures},</if>
            <if test="defaultImageSize != null">#{defaultImageSize},</if>
            <if test="modelDescription != null">#{modelDescription},</if>
            <if test="accessMode != null and accessMode != ''">#{accessMode},</if>
            <if test="maxConcurrency != null">#{maxConcurrency},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            '0',
            NOW()
        )
    </insert>

    <update id="updateModelConfig" parameterType="com.polaris.ai.domain.AiModelConfig">
        UPDATE ai_model_config
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="provider != null and provider != ''">provider = #{provider},</if>
            <if test="modelName != null and modelName != ''">model_name = #{modelName},</if>
            <if test="apiKey != null">api_key = #{apiKey},</if>
            <if test="baseUrl != null">base_url = #{baseUrl},</if>
            <if test="maxTokens != null">max_tokens = #{maxTokens},</if>
            <if test="temperature != null">temperature = #{temperature},</if>
            <if test="maxHistoryMessages != null">max_history_messages = #{maxHistoryMessages},</if>
            <if test="systemPrompt != null">system_prompt = #{systemPrompt},</if>
            <if test="isDefault != null and isDefault != ''">is_default = #{isDefault},</if>
            <if test="modelType != null and modelType != ''">model_type = #{modelType},</if>
            enabled_tools = #{enabledTools},
            <if test="enableThinking != null and enableThinking != ''">enable_thinking = #{enableThinking},</if>
            <if test="reasoningEffort != null and reasoningEffort != ''">reasoning_effort = #{reasoningEffort},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="enableSearch != null and enableSearch != ''">enable_search = #{enableSearch},</if>
            <if test="searchKey != null">search_key = #{searchKey},</if>
            <if test="imageCapabilities != null">image_capabilities = #{imageCapabilities},</if>
            <if test="modelFeatures != null">model_features = #{modelFeatures},</if>
            <if test="defaultImageSize != null">default_image_size = #{defaultImageSize},</if>
            <if test="modelDescription != null">model_description = #{modelDescription},</if>
            <if test="accessMode != null and accessMode != ''">access_mode = #{accessMode},</if>
            <if test="maxConcurrency != null">max_concurrency = #{maxConcurrency},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>


    <update id="cleanDefaultStatus">
        UPDATE ai_model_config 
        SET is_default = '0' 
        WHERE model_type = #{modelType} AND is_default = '1'
        <choose>
            <when test="deptId != null">
                AND dept_id = #{deptId}
            </when>
            <otherwise>
                AND dept_id IS NULL
            </otherwise>
        </choose>
    </update>

    <select id="selectAvailableModelConfigs" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        WHERE status = '1' AND del_flag = '0' AND model_type = 'CHAT'
        <if test="!isAdmin">
            <choose>
                <when test="deptId != null">
                    AND (dept_id IS NULL OR dept_id = #{deptId})
                </when>
                <otherwise>
                    AND dept_id IS NULL
                </otherwise>
            </choose>
        </if>
        ORDER BY create_time DESC
    </select>

</mapper>
