{
  "code": "AUDIO_TTS",
  "name": "语音合成",
  "kind": "INVOCATION",
  "category": "AUDIO",
  "schemaVersion": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["voice", "format"],
    "properties": {
      "voice": {"type": "string", "title": "音色", "minLength": 1, "maxLength": 100},
      "format": {"type": "string", "title": "音频格式", "enum": ["mp3", "wav", "opus", "aac", "flac"], "default": "mp3"},
      "sampleRate": {"type": "integer", "title": "采样率", "enum": [8000, 16000, 22050, 24000, 44100, 48000], "default": 24000},
      "speed": {"type": "number", "title": "语速", "minimum": 0.25, "maximum": 4, "default": 1},
      "pitch": {"type": "number", "title": "音调", "minimum": -20, "maximum": 20, "default": 0}
    }
  },
  "uiSchema": {
    "voice": {"component": "custom", "customComponent": "voice-selector", "optionsResolver": "PROVIDER_VOICES", "order": 10},
    "format": {"component": "select", "order": 20},
    "sampleRate": {"component": "select", "order": 30},
    "speed": {"component": "slider", "order": 40, "step": 0.05},
    "pitch": {"component": "slider", "order": 50, "step": 1}
  },
  "parameterPolicy": {
    "voice": {"overridable": true, "allowedSources": ["APPLICATION", "AGENT", "WORKFLOW", "REQUEST"]},
    "format": {"overridable": true, "allowedSources": ["APPLICATION", "WORKFLOW", "REQUEST"]},
    "speed": {"overridable": true, "allowedSources": ["APPLICATION", "WORKFLOW", "REQUEST"]},
    "pitch": {"overridable": true, "allowedSources": ["APPLICATION", "WORKFLOW", "REQUEST"]}
  }
}
