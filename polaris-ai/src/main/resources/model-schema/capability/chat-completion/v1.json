{
  "code": "CHAT_COMPLETION",
  "name": "聊天生成",
  "kind": "INVOCATION",
  "category": "CHAT",
  "schemaVersion": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxTokens": {
        "title": "最大输出长度",
        "type": "integer",
        "minimum": 1,
        "maximum": 200000,
        "default": 2048
      },
      "temperature": {
        "title": "随机性",
        "type": "number",
        "minimum": 0,
        "maximum": 2,
        "default": 0.7
      }
    }
  },
  "uiSchema": {
    "maxTokens": {
      "component": "number",
      "order": 10
    },
    "temperature": {
      "component": "slider",
      "order": 20,
      "step": 0.1
    }
  },
  "parameterPolicy": {
    "maxTokens": {
      "overridable": true,
      "allowedSources": ["APPLICATION", "AGENT", "WORKFLOW", "REQUEST"]
    },
    "temperature": {
      "overridable": true,
      "allowedSources": ["APPLICATION", "AGENT", "WORKFLOW", "REQUEST"]
    }
  }
}
