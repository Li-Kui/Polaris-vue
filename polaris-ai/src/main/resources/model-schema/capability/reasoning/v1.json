  },
  "uiSchema": {
    "effort": {
      "component": "select",
      "order": 10
    },
    "activationPolicy": {
      "component": "select",
      "order": 20
    }
  },
  "parameterPolicy": {
    "effort": {
      "overridable": true,
      "allowedSources": ["APPLICATION", "AGENT", "WORKFLOW", "REQUEST"]
    },
    "activationPolicy": {
      "overridable": false
    }
  },
  "allowedAppliesTo": ["CHAT_COMPLETION"]
